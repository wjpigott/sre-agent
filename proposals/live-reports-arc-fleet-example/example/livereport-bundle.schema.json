{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sreagent.livereport/v1",
  "title": "Azure SRE Agent Live Report bundle",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "schemaVersion": {
      "const": "sreagent.livereport/v1"
    },
    "kind": {
      "const": "LiveReport"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "description",
        "exportedAt"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "sourceReportId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceVersion": {
          "type": [
            "integer",
            "null"
          ]
        },
        "sourceAgent": {
          "type": [
            "string",
            "null"
          ]
        },
        "exportedAt": {
          "type": "string"
        },
        "exportedBy": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "allowedTools",
        "html",
        "htmlSha256",
        "htmlBytes"
      ],
      "properties": {
        "allowedTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "html": {
          "type": "string",
          "description": "Saved report source, byte-exact, with raw {REPORT_NONCE} placeholders"
        },
        "htmlSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "htmlBytes": {
          "type": "integer"
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "occurrences"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "occurrences": {
            "type": "integer"
          },
          "detectedFrom": {
            "type": "string"
          }
        }
      }
    },
    "requirements": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
