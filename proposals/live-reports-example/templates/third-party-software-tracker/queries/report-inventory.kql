// Raw inventory query used by report/third-party-software-tracker.html (keep in sync).
// Source: Azure Change Tracking & Inventory -> Log Analytics table ConfigurationData.
// - Windows applications only (Linux dpkg/rpm rows are not SoftwareType "Application"
//   and otherwise flood the row limit).
// - Non-Microsoft publishers, KB/hotfix rows removed.
// - Only rows from each machine's latest inventory pass, so uninstalled or
//   upgraded software does not linger.
let sw = ConfigurationData
| where TimeGenerated > ago(7d)
| where ConfigDataType == "Software"
| where SoftwareType == "Application"
| where isnotempty(Publisher) and Publisher !has "Microsoft"
| where SoftwareName !has "Update for" and SoftwareName !has "Security Update" and SoftwareName !has "Hotfix for" and SoftwareName !has "Definition Update";
let lastInv = sw | summarize LastInventory = max(TimeGenerated) by Computer;
sw
| summarize arg_max(TimeGenerated, *) by Computer, SoftwareName
| join kind=inner lastInv on Computer
| where TimeGenerated >= LastInventory - 26h
| project Computer, SoftwareName, CurrentVersion, Publisher, SoftwareType, TimeGenerated, LastInventory
| sort by SoftwareName asc, Computer asc
